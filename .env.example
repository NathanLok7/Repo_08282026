# Modo local: SQLite + archivos en disco (.data/), sin nube. Bórralo o
# ponlo en false para usar Postgres/Blob de Vercel de verdad.
LOCAL_DEV=true

# Vercel Postgres (Storage -> Create Database -> Postgres, corre sobre Neon).
# Solo se usa si LOCAL_DEV no es "true". En Vercel se inyecta sola al
# conectar la BD al proyecto; en local, cópiala desde el dashboard.
POSTGRES_URL=postgres://usuario:password@host/db?sslmode=require

# Vercel Blob (Storage -> Create Database -> Blob). Igual, solo si
# LOCAL_DEV no es "true".
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Cadena aleatoria larga para firmar la cookie de sesión (RFC).
# Genera una con: openssl rand -base64 32
SESSION_SECRET=cambia-esto-por-algo-largo-y-aleatorio
