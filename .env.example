# Vercel Postgres (Storage -> Create Database -> Postgres, corre sobre Neon).
# En Vercel estas variables se inyectan solas al conectar la BD al proyecto;
# en local, copia el valor de POSTGRES_URL desde el dashboard.
POSTGRES_URL=postgres://usuario:password@host/db?sslmode=require

# Vercel Blob (Storage -> Create Database -> Blob).
# En Vercel se inyecta sola; en local cópiala desde el dashboard del store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Cadena aleatoria larga para firmar la cookie de sesión (RFC).
# Genera una con: openssl rand -base64 32
SESSION_SECRET=cambia-esto-por-algo-largo-y-aleatorio
